{
  "name": "@mole/vscode",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "displayName": "Mole: Code Map",
  "description": "A map of the file you are looking at, beside the code: what it defines, who calls it, what it calls, who imports it. Local only, TypeScript.",
  "publisher": "raychu23",
  "engines": {
    "vscode": "^1.101.0"
  },
  "main": "./dist/extension.cjs",
  "activationEvents": [
    "onStartupFinished",
    "onWebviewPanel:mole.map",
    "onView:mole.panelView"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "mole",
          "title": "Mole",
          "icon": "media/icon.png"
        }
      ]
    },
    "views": {
      "mole": [
        {
          "id": "mole.panelView",
          "name": "The code behind this",
          "type": "webview",
          "contextualTitle": "Mole"
        }
      ]
    },
    "commands": [
      {
        "command": "mole.openMap",
        "title": "Open map beside the code",
        "category": "Mole"
      },
      {
        "command": "mole.toggleImpact",
        "title": "Toggle impact view",
        "category": "Mole"
      },
      {
        "command": "mole.reindex",
        "title": "Re-index repository",
        "category": "Mole"
      },
      {
        "command": "mole.cli.map",
        "title": "Map: what this calls, who calls it (mole map)",
        "category": "Mole"
      },
      {
        "command": "mole.cli.impact",
        "title": "Impact: blast radius of a change (mole impact)",
        "category": "Mole"
      },
      {
        "command": "mole.cli.noteAdd",
        "title": "Add a note on this code (mole note add)",
        "category": "Mole"
      },
      {
        "command": "mole.cli.memory",
        "title": "Your notes (mole memory)",
        "category": "Mole"
      },
      {
        "command": "mole.cli.since",
        "title": "Since you last looked (mole since)",
        "category": "Mole"
      },
      {
        "command": "mole.cli.pastFixes",
        "title": "Past fixes behind these lines (mole check)",
        "category": "Mole"
      },
      {
        "command": "mole.cli.questions",
        "title": "Questions this change assumes (mole check)",
        "category": "Mole"
      },
      {
        "command": "mole.cli.decisions",
        "title": "Decisions that govern this code (mole decisions)",
        "category": "Mole"
      },
      {
        "command": "mole.cli.rules",
        "title": "Decision-rule violations (mole rules)",
        "category": "Mole"
      },
      {
        "command": "mole.cli.runTests",
        "title": "Run the tests that guard this change (mole check --run-tests)",
        "category": "Mole"
      },
      {
        "command": "mole.cli.claims",
        "title": "Agent claims, checked against what it did (mole claims)",
        "category": "Mole"
      },
      {
        "command": "mole.cli.flows",
        "title": "Blast radius: runtime call flows (mole flows)",
        "category": "Mole"
      },
      {
        "command": "mole.cli.collisions",
        "title": "Parallel-agent collisions (mole collisions)",
        "category": "Mole"
      },
      {
        "command": "mole.cli.tried",
        "title": "What was already tried here (mole tried)",
        "category": "Mole"
      }
    ],
    "configuration": {
      "title": "Mole",
      "properties": {
        "mole.autoOpen": {
          "type": "boolean",
          "default": true,
          "description": "Open the map panel beside the editor on startup."
        },
        "mole.tsconfig": {
          "type": "string",
          "description": "tsconfig to take compiler options from (default: none, built-in defaults)."
        },
        "mole.srcDir": {
          "type": "string",
          "description": "Folder to index, relative to the workspace (default: src if it exists, otherwise the whole workspace; node_modules, dist and dot-folders are skipped)."
        },
        "mole.stateDir": {
          "type": "string",
          "description": "Where the daemon keeps its lock and graph (default: .git/mole)."
        },
        "mole.daemonCli": {
          "type": "string",
          "description": "Advanced: path to a Mole daemon cli. Default: the one bundled with this extension."
        },
        "mole.idleMinutes": {
          "type": "number",
          "default": 30,
          "minimum": 0,
          "description": "The background indexer stops after this many minutes without a request and is restarted when needed (0 = never stop)."
        },
        "mole.recordSeen": {
          "type": "boolean",
          "default": true,
          "description": "Record which symbols you looked at (visible for 5 s or hovered) in .mole/local/seen.jsonl, so `mole since` can list what changed after your last look. Personal: the folder is gitignored and never leaves this machine."
        }
      }
    }
  },
  "scripts": {
    "build": "tsc -b",
    "bundle": "node esbuild.mjs",
    "package": "node scripts/package.mjs",
    "hover-check": "node scripts/hover-check.mjs"
  },
  "devDependencies": {
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "ovsx": "^1.3.0"
  },
  "dependencies": {
    "@mole/core": "*",
    "@mole/daemon": "*",
    "@mole/decisions": "*",
    "@mole/history": "*",
    "@mole/layout": "*",
    "@mole/memory": "*",
    "@mole/oneonone": "*",
    "@mole/questions": "*",
    "@mole/reviews": "*",
    "@mole/verify": "*"
  },
  "categories": [
    "Visualization",
    "Education",
    "Other"
  ],
  "keywords": [
    "code map",
    "call graph",
    "typescript",
    "code navigation",
    "learning",
    "impact analysis"
  ],
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#202430",
    "theme": "dark"
  },
  "extensionKind": [
    "workspace"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/raychu23/mole-code-map.git",
    "directory": "apps/vscode"
  },
  "homepage": "https://github.com/raychu23/mole-code-map#readme",
  "bugs": {
    "url": "https://github.com/raychu23/mole-code-map/issues"
  }
}

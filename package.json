{
  "name": "mole",
  "version": "0.0.0",
  "private": true,
  "description": "Mole: visual codebase map that follows the file you open, shared with your agents",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run",
    "check": "npm run build && npm test",
    "bundle": "npm run bundle -w @mole/vscode"
  },
  "engines": {
    "node": ">=22.13"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
